{
  "info": {
    "_postman_id": "vitalpulse-ai-collection-2026",
    "name": "VitalPulse AI - Health Monitoring System API",
    "description": "Comprehensive REST API collection for VitalPulse AI health monitoring, clinical analytics, rule-based alerts, AI assistant, and physician sharing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "patientToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. System Health",
      "item": [
        {
          "name": "GET System Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "POST Patient Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@healthmonitor.io\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "POST Doctor Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@healthmonitor.io\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "POST Admin Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@healthmonitor.io\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "POST Register New Patient",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Marcus Aurelius\",\n  \"email\": \"marcus@healthmonitor.io\",\n  \"password\": \"Password123!\",\n  \"role\": \"patient\",\n  \"gender\": \"male\",\n  \"height\": 180,\n  \"weight\": 78\n}"
            }
          }
        },
        {
          "name": "GET Current User Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }]
          }
        }
      ]
    },
    {
      "name": "03. Measurements & Vitals",
      "item": [
        {
          "name": "POST Record Blood Pressure (Anomaly Trigger)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/measurements",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"bloodPressure\",\n  \"unit\": \"mmHg\",\n  \"source\": \"bp_cuff\",\n  \"notes\": \"Recorded at resting posture\",\n  \"valueDetails\": {\n    \"systolic\": 142,\n    \"diastolic\": 92\n  }\n}"
            }
          }
        },
        {
          "name": "POST Record Heart Rate",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/measurements",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"heartRate\",\n  \"value\": 72,\n  \"unit\": \"bpm\",\n  \"source\": \"smart_watch\",\n  \"notes\": \"Resting pulse rate\"\n}"
            }
          }
        },
        {
          "name": "GET Measurements List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/measurements?page=1&limit=20",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }]
          }
        }
      ]
    },
    {
      "name": "04. Health Analytics & Trends",
      "item": [
        {
          "name": "GET Vitals Overview Summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/summary",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }]
          }
        },
        {
          "name": "GET Time-Series Trends",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/trends?vitalType=heartRate&days=30",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }]
          }
        },
        {
          "name": "GET Clinical Alerts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/alerts?status=unacknowledged",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }]
          }
        }
      ]
    },
    {
      "name": "05. AI Health Assistant",
      "item": [
        {
          "name": "POST AI Explain Measurement",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/explain-measurement",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vitalType\": \"bloodPressure\",\n  \"unit\": \"mmHg\",\n  \"valueDetails\": { \"systolic\": 135, \"diastolic\": 85 }\n}"
            }
          }
        },
        {
          "name": "POST AI Conversational Chat",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/chat",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What questions should I ask my doctor about my recent blood pressure readings?\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "06. PDF Reports",
      "item": [
        {
          "name": "POST Generate PDF Health Report",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/reports",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Monthly Comprehensive Health Assessment\",\n  \"startDate\": \"2026-09-26T00:00:00.000Z\",\n  \"endDate\": \"2026-10-26T00:00:00.000Z\",\n  \"includedSections\": {\n    \"measurements\": true,\n    \"vitalsSummary\": true,\n    \"symptoms\": true,\n    \"medications\": true,\n    \"appointments\": true,\n    \"aiSummary\": true\n  }\n}"
            }
          }
        },
        {
          "name": "GET Reports List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }]
          }
        }
      ]
    },
    {
      "name": "07. Doctor Portal & Consent",
      "item": [
        {
          "name": "GET Consented Patients for Doctor",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/doctor/patients",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }]
          }
        },
        {
          "name": "POST Add Physician Note",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/doctor/patients/:patientId/notes",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Vitals stable. Continue current dietary lifestyle and medication schedule.\",\n  \"recommendation\": \"Recheck morning blood pressure twice weekly.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "08. System Administration & Audit",
      "item": [
        {
          "name": "GET Admin Dashboard Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "GET HIPAA Audit Logs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/audit-logs",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    }
  ]
}
